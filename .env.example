# Docker: copy this file to .env to change a setting. Every Docker setting is
# optional; "docker compose up -d --build" also works without a .env file.
# Never commit .env.

# --- Service: frontend (Docker Compose, applied when the container starts) ---
# Host address to publish on. 127.0.0.1 = this computer only.
# Use 0.0.0.0 to allow other devices on your network.
FRONTEND_BIND_ADDRESS=127.0.0.1
# Host port. The app opens at http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=8080

# --- Service: frontend (applied at image build time) ---
# Link opened by the AI assistant button. Leave empty for the built-in default.
# Public value (it ends up in the browser bundle). Rebuild after changing it.
VITE_GEMINI_GEM_URL=

# --- Supabase (NOT used by the current app or by Docker) ---
# Kept from the earlier Supabase setup; see SUPABASE_SETUP.md. Setting these
# has no effect on the app that is built today. Never put a service-role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
